{
  "name": "gslide-opener",
  "version": "2.3.9",
  "buildNumber": "86",
  "description": "Quick Google Slides deck switcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --watch",
    "build": "electron-builder",
    "build:win": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win portable",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "build:icon:win": "node scripts/build-windows-icon.js",
    "download:cloudflared": "bash scripts/download-cloudflared.sh",
    "smoke:slides-gpu": "electron scripts/slides-presenter-gpu-smoke.cjs",
    "capture:readme-screenshots": "cross-env GSO_README_CAPTURE=1 electron .",
    "test": "node --test 'tests/**/*.test.js'"
  },
  "keywords": [
    "electron",
    "google-slides",
    "presentation"
  ],
  "author": "TomsFaire (based on work by nerif-tafu)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TomsFaire/Google-Slides-Controller.git"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "com.gslide.opener",
    "productName": "Google Slides Opener",
    "publish": null,
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "src/**/*",
      "BUILD-INFO.txt",
      "build/icon.icns",
      "build/icon.png",
      "build/icon.ico"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signingHashAlgorithms": []
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "gatekeeperAssess": false,
      "electronLanguages": [
        "en-US"
      ]
    },
    "extraResources": [
      "BUILD-INFO.txt",
      {
        "from": "resources/cloudflared",
        "to": "cloudflared",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterPack": "./scripts/after-pack-mac.js"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
